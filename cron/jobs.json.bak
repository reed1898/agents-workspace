      "sessionTarget": "isolated",
      "wakeMode": "now",
      "payload": {
        "kind": "agentTurn",
        "message": "你是小洪，Reed 的数字分身。任务：执行 OpenClaw 安全扫描。步骤：1) 运行 'openclaw status' 检查整体健康状态；2) 检查 gateway 配置安全性（端口、bind、auth token 是否泄漏等）；3) 检查 ~/.openclaw/openclaw.json 中是否有敏感信息暴露风险；4) 检查 skills 目录是否有异常文件或权限问题；5) 检查 cron 任务是否有异常新增；6) 把发现的问题按严重程度（高/中/低）列出，并尝试自动修复低风险问题；7) 把完整报告写入 ~/workspace/memory/security-report-YYYY-MM-DD-evening.md；8) 通过 Telegram 私聊发给 Reed 摘要（严重问题必须标红说明，无问题也要确认一句「安全检查通过」）。",
        "timeoutSeconds": 180
      },
      "delivery": {
        "mode": "announce",
        "channel": "last"
      },
