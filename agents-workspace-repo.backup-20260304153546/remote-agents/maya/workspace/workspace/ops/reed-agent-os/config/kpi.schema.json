{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reed-agent-os.local/schemas/kpi.schema.json",
  "title": "Reed Agent OS KPI Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "skeleton_mode",
    "daily_success_rate",
    "dual_write_consistency",
    "e2e_report_latency"
  ],
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "skeleton_mode": { "type": "boolean" },
    "daily_success_rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_tasks", "successful_tasks", "rate_percent", "target_percent"],
      "properties": {
        "total_tasks": { "type": "integer", "minimum": 0 },
        "successful_tasks": { "type": "integer", "minimum": 0 },
        "rate_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "target_percent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "dual_write_consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_reports", "matched_reports", "rate_percent", "target_percent"],
      "properties": {
        "expected_reports": { "type": "integer", "minimum": 0 },
        "matched_reports": { "type": "integer", "minimum": 0 },
        "rate_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "target_percent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "e2e_report_latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "p50_seconds", "p95_seconds", "target_p50_seconds", "target_p95_seconds"],
      "properties": {
        "samples": { "type": "integer", "minimum": 0 },
        "p50_seconds": { "type": "number", "minimum": 0 },
        "p95_seconds": { "type": "number", "minimum": 0 },
        "target_p50_seconds": { "type": "number", "minimum": 0 },
        "target_p95_seconds": { "type": "number", "minimum": 0 }
      }
    }
  }
}
