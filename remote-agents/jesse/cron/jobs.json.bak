    {
      "id": "b316ad5d-dc1c-4244-9193-35bbfe3b445b",
      "agentId": "main",
      "sessionKey": "agent:main:discord:channel:1471363336192131276",
      "name": "jesse-kb-hourly-closed-loop",
      "enabled": true,
