{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heartbeat.schema.json",
  "type": "object",
  "required": ["agent_id", "last_seen", "interval_sec"],
  "properties": {
    "agent_id": { "type": "string" },
    "last_seen": { "type": "string", "format": "date-time" },
    "interval_sec": { "type": "number" },
    "status": { "type": "string" }
  }
}
