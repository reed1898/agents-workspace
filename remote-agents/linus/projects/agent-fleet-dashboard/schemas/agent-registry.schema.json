{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-registry.schema.json",
  "type": "object",
  "required": ["updated_at", "agents"],
  "properties": {
    "updated_at": { "type": "string", "format": "date-time" },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "role"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "description": { "type": "string" },
          "owner": { "type": "string" }
        }
      }
    }
  }
}
