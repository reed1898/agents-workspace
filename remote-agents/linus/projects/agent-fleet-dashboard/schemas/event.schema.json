{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "type": "object",
  "required": ["ts", "agent_id", "type", "level", "message"],
  "properties": {
    "ts": { "type": "string", "format": "date-time" },
    "agent_id": { "type": "string" },
    "type": { "type": "string" },
    "level": { "type": "string", "enum": ["info", "warn", "error"] },
    "message": { "type": "string" },
    "meta": { "type": "object" }
  }
}
